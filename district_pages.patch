     <h2>Quick Facts</h2>
     <div class="facts-grid"><div class="fact-card"><div class="label">District HQ</div><div class="value">Chamba</div></div><div class="fact-card"><div class="label">Area</div><div class="value">6528 km²</div></div><div class="fact-card"><div class="label">Altitude</div><div class="value">650–6400 m</div></div><div class="fact-card"><div class="label">Best Season</div><div class="value">Apr–Jun, Sep–Nov</div></div><div class="fact-card"><div class="label">Summer Temp</div><div class="value">15–30°C</div></div><div class="fact-card"><div class="label">Winter Temp</div><div class="value">-5–10°C</div></div><div class="fact-card"><div class="label">Nearest Airport</div><div class="value">Gaggal (Kangra) / Pathankot</div></div><div class="fact-card"><div class="label">From Delhi</div><div class="value">553 km</div></div></div>
