+/* ---------- Mobile menu drawer fixes (pairs with he-mobile-nav.js) ---------- */
+@media (max-width:900px){
+  /* The drawer (z-index 1049, inside the header) painted over the burger, so the X could not be tapped.
+     Lift only the burger above it. */
+  .he-header .he-burger{ position:relative; z-index:1051; min-width:44px; min-height:44px; }
+  /* Closed drawer is only translated off-screen; take it out of the tab order / a11y tree too.
+     Visibility flips after the slide-out finishes so the close animation still plays. */
+  .he-header .he-nav-links{ visibility:hidden; overscroll-behavior:contain; transition:transform .25s ease, visibility 0s linear .25s; }
+  .he-header .he-nav-links.he-open{ visibility:visible; transition:transform .25s ease, visibility 0s; }
+}
+/* Stop the page scrolling behind the open drawer */
+html.he-menu-lock, html.he-menu-lock body{ overflow:hidden; }
+
+@media (prefers-reduced-motion: reduce){
+  .he-top-btn, .he-header, .he-header .he-nav-links, .he-header .he-nav-links.he-open{ transition:none; }
+}
