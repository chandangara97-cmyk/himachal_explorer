{
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  "name": "{{Package name as shown on the page}}",
  "url": "https://himachalexplorer.in/pkg/{{slug}}.html",
  "description": "{{Description shown on the page}}",
  "provider": {
    "@id": "https://himachalexplorer.in/#organization"
  },
  "itinerary": {
    "@type": "ItemList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Day 1: {{as shown on the page}}"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Day 2: {{as shown on the page}}"
      }
    ]
  }
}
